# Local dev defaults — never use these values in any deployed environment

# PostgreSQL
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=devdb

# Claude / Anthropic — required for claude CLI inside the container
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI / Codex — required for openai SDK inside the container
OPENAI_API_KEY=sk-...

# Paperclip harness
# host-only mode (harness runs on your machine): leave as-is
# fully remote mode (harness runs inside or alongside the container): set to the remote endpoint
PAPERCLIP_API_URL=http://host.docker.internal:3100
PAPERCLIP_API_KEY=
